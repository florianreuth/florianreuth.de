---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} — ${profile.name}`} description={`${title} von ${profile.name}`}>
    <main class="legal">
        <a class="back" href="/">← Startseite</a>
        <h1>{title}</h1>
        <slot/>
        <Footer/>
    </main>
</Base>

<style>
    .legal {
        width: 100%;
        max-width: 40rem;
        margin: 0 auto;
        text-wrap: pretty;
        overflow-wrap: anywhere;
    }

    h1 {
        margin-top: 24px;
        font-size: clamp(2rem, 9vw, 2.75rem);
        font-weight: 650;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .legal :global(h2) {
        margin-top: 40px;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .legal :global(h3) {
        margin-top: 24px;
        font-size: 1rem;
        font-weight: 600;
    }

    .legal :global(p),
    .legal :global(ul) {
        margin-top: 12px;
    }

    .legal :global(ul) {
        padding-left: 1.25em;
    }

    .legal :global(a) {
        color: var(--accent);
        text-underline-offset: 3px;
    }

    .back {
        font-size: 0.875rem;
        text-decoration: none;
    }
</style>
